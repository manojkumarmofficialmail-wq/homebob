# Copy to Vercel → Project → Settings → Environment Variables (never commit real keys).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Family sync: the PUBLISHABLE key (sb_publishable_…) or legacy anon key. Never the secret key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Optional AI helper (free tier) for voice sentences Homzy's parser can't read and nutrition of new ingredients.
# Get a key at https://aistudio.google.com/apikey. Without it, everything still works with the built-in parser.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Optional: morning reminders on phones. Make keys once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Any long random text. Vercel sends it to /api/remind with each daily cron call.
CRON_SECRET=
# Optional: extra origins allowed to post feedback, e.g. a custom domain
ALLOWED_ORIGINS=
